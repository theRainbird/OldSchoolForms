{
  "format": "OldSchoolForms.Layout",
  "version": 1,
  "rootType": "Form",
  "rootSize": { "width": 1100, "height": 720 },
  "controls": [
    {
      "type": "MenuStrip",
      "name": "menuStrip",
      "props": { "dock": "Top" },
      "items": [
        {
          "type": "ToolStripMenuItem",
          "props": { "text": "tr:Shell_Menu_File" },
          "dropDownItems": [
            { "type": "ToolStripMenuItem", "props": { "text": "tr:Shell_Menu_Exit" } }
          ]
        },
        {
          "type": "ToolStripMenuItem",
          "props": { "text": "tr:Shell_Menu_Language" },
          "dropDownItems": [
            { "type": "ToolStripMenuItem", "name": "culture:de", "props": { "text": "Deutsch" } },
            { "type": "ToolStripMenuItem", "name": "culture:en", "props": { "text": "English" } }
          ]
        },
        {
          "type": "ToolStripMenuItem",
          "props": { "text": "tr:Shell_Menu_Help" },
          "dropDownItems": [
            { "type": "ToolStripMenuItem", "props": { "text": "tr:Shell_Menu_About" } }
          ]
        }
      ]
    },
    {
      "type": "ToolStrip",
      "name": "toolStrip",
      "props": { "dock": "Top" },
      "items": [
        { "type": "ToolStripButton", "props": { "text": "tr:Shell_Tb_Start" } },
        { "type": "ToolStripSeparator" },
        { "type": "ToolStripLabel", "props": { "text": "tr:Shell_Tb_Title" } }
      ]
    },
    {
      "type": "StatusStrip",
      "name": "statusStrip",
      "props": { "dock": "Bottom" },
      "items": [
        { "type": "ToolStripStatusLabel", "props": { "text": "tr:Shell_Status_Ready" } }
      ]
    },
    {
      "type": "Panel",
      "name": "sidebar",
      "props": { "dock": "Left", "size": { "width": 220, "height": 600 } },
      "children": [
        { "type": "TreeView", "name": "navTree", "props": { "dock": "Fill" } }
      ]
    },
    {
      "type": "TabControl",
      "name": "contentTabs",
      "props": { "dock": "Fill" }
    }
  ]
}
