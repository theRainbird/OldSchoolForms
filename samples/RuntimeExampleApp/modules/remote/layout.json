{
  "format": "OldSchoolForms.Layout",
  "version": 1,
  "rootType": "Form",
  "controls": [
    {
      "type": "ToolStrip",
      "name": "navStrip",
      "props": { "dock": "Top" },
      "items": [
        { "type": "ToolStripButton", "name": "navFirst", "props": { "text": "tr:Remote_First" } },
        { "type": "ToolStripButton", "name": "navPrev", "props": { "text": "tr:Remote_Prev" } },
        { "type": "ToolStripLabel", "name": "posLabel", "props": { "text": "" } },
        { "type": "ToolStripButton", "name": "navNext", "props": { "text": "tr:Remote_Next" } },
        { "type": "ToolStripButton", "name": "navLast", "props": { "text": "tr:Remote_Last" } },
        { "type": "ToolStripSeparator" },
        { "type": "ToolStripButton", "name": "btnAdd", "props": { "text": "tr:Remote_Add" } },
        { "type": "ToolStripButton", "name": "btnSave", "props": { "text": "tr:Remote_Save" } },
        { "type": "ToolStripSeparator" },
        { "type": "ToolStripButton", "name": "btnLoad", "props": { "text": "tr:Remote_Load" } },
        { "type": "ToolStripButton", "name": "btnLoadAsync", "props": { "text": "tr:Remote_LoadAsync" } },
        { "type": "ToolStripButton", "name": "btnValidate", "props": { "text": "tr:Remote_Validate" } }
      ]
    },
    {
      "type": "Panel",
      "name": "editPanel",
      "props": { "dock": "Top", "size": { "width": 672, "height": 80 } },
      "children": [
        { "type": "Label", "name": "filterLabel", "props": { "text": "tr:Remote_Filter", "location": { "x": 16, "y": 10 }, "size": { "width": 50, "height": 24 } } },
        { "type": "TextBox", "name": "filterBox", "props": { "text": "", "location": { "x": 70, "y": 8 }, "size": { "width": 250, "height": 26 } } },
        { "type": "Button", "name": "btnApply", "props": { "text": "tr:Remote_Apply", "location": { "x": 328, "y": 7 }, "size": { "width": 90, "height": 28 } } },
        { "type": "Label", "name": "sortLabel", "props": { "text": "tr:Remote_Sort", "location": { "x": 428, "y": 10 }, "size": { "width": 40, "height": 24 } } },
        { "type": "TextBox", "name": "sortBox", "props": { "text": "name ASC", "location": { "x": 472, "y": 8 }, "size": { "width": 184, "height": 26 } } },
        { "type": "Label", "name": "nameLabel", "props": { "text": "tr:Remote_Name", "location": { "x": 16, "y": 46 }, "size": { "width": 50, "height": 24 } } },
        { "type": "TextBox", "name": "nameBox", "props": { "text": "", "location": { "x": 70, "y": 44 }, "size": { "width": 180, "height": 26 } } },
        { "type": "Label", "name": "emailLabel", "props": { "text": "tr:Remote_Email", "location": { "x": 262, "y": 46 }, "size": { "width": 50, "height": 24 } } },
        { "type": "TextBox", "name": "emailBox", "props": { "text": "", "location": { "x": 316, "y": 44 }, "size": { "width": 200, "height": 26 } } },
        { "type": "Label", "name": "ageLabel", "props": { "text": "tr:Remote_Age", "location": { "x": 528, "y": 46 }, "size": { "width": 40, "height": 24 } } },
        { "type": "TextBox", "name": "ageBox", "props": { "text": "", "location": { "x": 572, "y": 44 }, "size": { "width": 84, "height": 26 } } }
      ]
    },
    { "type": "Label", "name": "statusLabel", "props": { "text": "", "dock": "Bottom", "size": { "width": 672, "height": 24 } } },
    {
      "type": "DataGridView",
      "name": "grid",
      "props": { "dock": "Fill" },
      "columns": [
        { "name": "colId", "headerText": "ID", "dataPropertyName": "id", "valueType": "Int64", "width": 60 },
        { "name": "colName", "headerText": "Name", "dataPropertyName": "name", "valueType": "String", "width": 200 },
        { "name": "colEmail", "headerText": "E-Mail", "dataPropertyName": "email", "valueType": "String", "width": 220 },
        { "name": "colAge", "headerText": "Alter", "dataPropertyName": "age", "valueType": "Int64", "width": 70 }
      ]
    }
  ]
}
