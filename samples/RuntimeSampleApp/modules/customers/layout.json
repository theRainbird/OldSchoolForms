{
  "format": "OldSchoolForms.Layout",
  "version": 1,
  "rootType": "Form",
  "rootSize": { "width": 760, "height": 520 },
  "controls": [
    {
      "type": "Label",
      "name": "searchLabel",
      "props": { "text": "Suche", "location": { "x": 12, "y": 14 } }
    },
    {
      "type": "TextBox",
      "name": "searchBox",
      "props": { "location": { "x": 70, "y": 10 }, "size": { "width": 240, "height": 24 } }
    },
    {
      "type": "Button",
      "name": "addButton",
      "props": { "text": "Hinzufügen", "location": { "x": 330, "y": 9 }, "size": { "width": 110, "height": 26 } }
    },
    {
      "type": "DataGridView",
      "name": "grid",
      "props": { "location": { "x": 12, "y": 48 }, "size": { "width": 736, "height": 440 } },
      "columns": [
        { "name": "id", "headerText": "Nr.", "width": 60, "valueType": "int" },
        { "name": "name", "headerText": "Name", "width": 260, "valueType": "string" },
        { "name": "city", "headerText": "Ort", "width": 200, "valueType": "string" },
        { "name": "active", "headerText": "Aktiv", "width": 90, "valueType": "bool" }
      ]
    }
  ]
}
